# =====================================================================
#  Дополнения к .env стека Supabase (E:\supabase-project\.env).
#
#  Базовые значения (POSTGRES_PASSWORD, JWT-ключи и прочее) создают
#  скрипты стека:
#      sh utils/generate-keys.sh
#      sh utils/add-new-auth-keys.sh
#  Ниже — то, что скрипты не знают и что нужно дописать руками.
# =====================================================================

# ── Адреса ────────────────────────────────────────────────────────────
SUPABASE_PUBLIC_URL=https://api.nepriziv.ru
API_EXTERNAL_URL=https://api.nepriziv.ru
SITE_URL=https://nepriziv.ru
ADDITIONAL_REDIRECT_URLS=https://www.nepriziv.ru,http://localhost:8080

# ── Studio ────────────────────────────────────────────────────────────
# Дашборд закрыт ТОЛЬКО этим паролем. Наружу его не выставляем (см.
# cloudflared-config.example.yml), но пароль всё равно должен быть
# длинным: Studio ходит в базу с полными правами.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ── Почта ─────────────────────────────────────────────────────────────
# Self-hosted Supabase не умеет отправлять письма без SMTP. Без этих
# строк не работают подтверждение регистрации и восстановление пароля —
# причём молча: пользователь просто не получает письмо.
# Resend уже подключён к проекту и даёт SMTP.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=nepriziv.ru

# ── Секреты edge-функций ──────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_MAIN=
OPENAI_MODEL_FAST=
OPENAI_MODEL_VISION=
JINA_API_KEY=
RESEND_API_KEY=

# Белый список Origin для CORS. Значение проверяется в
# supabase/functions/_shared/cors.ts. Без него запросы с сайта
# получат "null" в Access-Control-Allow-Origin и не пройдут.
ALLOWED_ORIGIN=https://nepriziv.ru

# ── Бюджет и лимиты ИИ ────────────────────────────────────────────────
AI_MONTHLY_BUDGET_RUB=1650
CHAT_ANON_MAX_PER_DAY=
CHAT_RAG_MAX_PER_DAY=

# Суточные лимиты дорогих функций (_shared/aiGuard.ts). Если не задать —
# действуют значения по умолчанию из кода, они указаны в скобках.
ANALYZE_DOCUMENT_MAX_PER_DAY=        # (40) два vision-вызова на документ
QUESTIONNAIRE_ANALYZE_MAX_PER_DAY=   # (30)
ENHANCE_DOCUMENT_MAX_PER_DAY=        # (30) единственная без авторизации
PARSE_SUMMONS_MAX_PER_DAY=           # (20)
GENERATE_APPEAL_MAX_PER_DAY=         # (15)

# ── Секрет cron ───────────────────────────────────────────────────────
# Секреты Vault НЕ переносятся дампом в расшифрованном виде — завести
# заново в локальной базе:
#   select vault.create_secret('<новый секрет>', 'cron_secret');
