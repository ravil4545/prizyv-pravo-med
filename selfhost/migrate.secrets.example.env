# Шаблон для selfhost/migrate.secrets.env (тот файл в .gitignore).
#
# Нужны именно service_role-ключи: приватные бакеты закрыты RLS, и
# анонимным ключом их не прочитать. service_role обходит RLS полностью —
# не коммитить и не вставлять в браузерный код.

# Облако — Settings -> API -> service_role secret
CLOUD_URL=https://kqbetheonxiclwgyatnm.supabase.co
CLOUD_SERVICE_KEY=

# Локальный стек — SUPABASE_SECRET_KEY (или SERVICE_ROLE_KEY) из .env стека
LOCAL_URL=http://localhost:8000
LOCAL_SERVICE_KEY=
